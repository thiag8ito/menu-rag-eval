ANTHROPIC_API_KEY=sk-ant-...      # só necessário para /ask e para evaluation.run_e2e
EMBEDDER=tfidf-char               # tfidf | tfidf-char | lsa | minilm-multi | e5-small | bge-m3
CHUNK_STRATEGY=structured         # fixed | structured
CHUNK_SIZE=1024
CONTEXTUAL_HEADER=1               # nome/culinária/bairro no texto embedado de cada chunk
HYBRID=1                          # BM25 + denso (RRF)
ENTITY_LINK=1                     # prioriza chunks do restaurante citado na pergunta
RERANKER=none                     # none | mmarco | bge-reranker
CANDIDATES_K=20
GENERATOR_MODEL=claude-haiku-5-5
JUDGE_MODEL=claude-sonnet-5-5
